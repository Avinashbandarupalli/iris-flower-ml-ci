
import json
import os
import unittest

import joblib
import pandas as pd


class TestIrisMLPipeline(unittest.TestCase):

    def test_dataset_created(self):
        self.assertTrue(os.path.exists("iris_dataset.csv"))

    def test_dataset_has_150_records(self):
        data = pd.read_csv("iris_dataset.csv")
        self.assertEqual(len(data), 150)

    def test_model_created(self):
        self.assertTrue(os.path.exists("iris_classifier.pkl"))

    def test_metrics_created(self):
        self.assertTrue(os.path.exists("metrics.json"))

    def test_accuracy_is_valid(self):
        with open("metrics.json", "r", encoding="utf-8") as file:
            metrics = json.load(file)

        accuracy = metrics["accuracy"]
        self.assertGreaterEqual(accuracy, 0.0)
        self.assertLessEqual(accuracy, 1.0)

    def test_model_prediction_is_valid_class(self):
        model = joblib.load("iris_classifier.pkl")

        sample = pd.DataFrame([{
            "sepal length (cm)": 5.1,
            "sepal width (cm)": 3.5,
            "petal length (cm)": 1.4,
            "petal width (cm)": 0.2
        }])

        prediction = model.predict(sample)[0]

        self.assertIn(
            prediction,
            ["setosa", "versicolor", "virginica"]
        )

    def test_known_setosa_sample(self):
        model = joblib.load("iris_classifier.pkl")

        sample = pd.DataFrame([{
            "sepal length (cm)": 5.1,
            "sepal width (cm)": 3.5,
            "petal length (cm)": 1.4,
            "petal width (cm)": 0.2
        }])

        prediction = model.predict(sample)[0]

        self.assertEqual(prediction, "setosa")


if __name__ == "__main__":
    unittest.main()
